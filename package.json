{
  "name": "fraterunion-payments",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "pnpm --filter @fraterunion-payments/database run db:generate",
    "db:format": "pnpm --filter @fraterunion-payments/database run db:format",
    "db:validate": "pnpm --filter @fraterunion-payments/database run db:validate",
    "db:migrate:dev": "pnpm --filter @fraterunion-payments/database run db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @fraterunion-payments/database run db:migrate:deploy",
    "db:seed": "pnpm --filter @fraterunion-payments/database run db:seed",
    "db:studio": "pnpm --filter @fraterunion-payments/database run db:studio",
    "dev:api": "pnpm --filter @fraterunion-payments/api run dev",
    "build:api": "pnpm --filter @fraterunion-payments/api run build",
    "start:api": "pnpm --filter @fraterunion-payments/api run start",
    "test:api": "pnpm --filter @fraterunion-payments/api run test",
    "test:api:e2e": "pnpm --filter @fraterunion-payments/api run test:e2e",
    "test:api:integration:db": "pnpm --filter @fraterunion-payments/api run test:integration:db",
    "test:api:auth": "pnpm --filter @fraterunion-payments/api run test:auth",
    "test:api:auth:integration": "pnpm --filter @fraterunion-payments/api run test:auth:integration"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
