NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1
ADMIN_PORT=3000
DOCS_PORT=3001
WORKER_PORT=4001
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=25
WORKER_CLAIM_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=10
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=900000
WORKER_CONCURRENCY=5
WORKER_SHUTDOWN_TIMEOUT_MS=30000
DATABASE_URL=
REDIS_URL=
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
# Required. Generate a strong random value, e.g. `openssl rand -hex 32`.
# Never reuse this value for API_KEY_HASH_SECRET.
JWT_ACCESS_SECRET=
JWT_ACCESS_ISSUER=fraterunion-payments
JWT_ACCESS_AUDIENCE=fraterunion-payments-api
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_PARALLELISM=1
# Required. Generate a strong random value, e.g. `openssl rand -hex 32`.
# Never reuse this value for JWT_ACCESS_SECRET.
API_KEY_HASH_SECRET=
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
