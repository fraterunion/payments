// FraterUnion Payments — core tenancy, customer, payment, and refund schema.
// See packages/database/README.md for naming conventions, deletion policy,
// indexing rationale, and the database-enforced vs. application-enforced
// validation boundary. See docs/decisions/ADR-002 and ADR-003.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("organization_status")
}

enum OrganizationType {
  /// A tenant business using FraterUnion Payments (GymOS, RestaurantOS, etc.).
  BUSINESS
  /// Reserved for FraterUnion-controlled operational organizations. Does not
  /// by itself grant cross-tenant access; authorization is defined later.
  INTERNAL

  @@map("organization_type")
}

enum MembershipRole {
  /// Ultimate tenant administration and billing/provider authority.
  OWNER
  /// Broad organization administration.
  ADMIN
  /// Integration and API access management.
  DEVELOPER
  /// Read-oriented reporting access.
  ANALYST
  /// Limited operational support capabilities.
  SUPPORT

  @@map("membership_role")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED

  @@map("user_status")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED

  @@map("api_key_status")
}

/// Named `ApiEnvironment` rather than `Environment` to avoid collision with
/// runtime-environment terminology (`NODE_ENV`, deployment environment).
/// This enum tracks whether an API key operates against test or live
/// provider data, independent of where the application itself is deployed.
enum ApiEnvironment {
  TEST
  LIVE

  @@map("api_environment")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_event_status")
}

enum InboxEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@map("inbox_event_status")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED

  @@map("customer_status")
}

/// Canonical FraterUnion Payments states. Values match payment-core
/// `PAYMENT_STATES` exactly. These are not provider statuses.
enum PaymentStatus {
  CREATED
  REQUIRES_PAYMENT_METHOD
  REQUIRES_ACTION
  AUTHORIZING
  AUTHORIZED
  CAPTURING
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

/// Canonical capture method. Not a provider-specific capture flag.
enum PaymentCaptureMethod {
  AUTOMATIC
  MANUAL

  @@map("payment_capture_method")
}

/// Normalized failure categories from payment-core. Not raw provider codes.
enum PaymentFailureCategory {
  DECLINED
  AUTHENTICATION
  INSUFFICIENT_FUNDS
  INVALID_PAYMENT_METHOD
  PROCESSING
  PROVIDER
  UNKNOWN

  @@map("payment_failure_category")
}

/// Canonical refund states. Values match payment-core `REFUND_STATES` exactly.
/// There is no CANCELED refund state.
enum RefundStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED

  @@map("refund_status")
}

/// Canonical refund reasons. Values match payment-core `REFUND_REASONS`.
enum RefundReason {
  CUSTOMER_REQUEST
  DUPLICATE
  FRAUDULENT
  PRODUCT_OR_SERVICE
  OTHER

  @@map("refund_reason")
}

/// Financial-command idempotency lifecycle. `COMPLETED` means the FUP
/// logical command has a durable result/binding — not that money settled
/// at a provider. `IN_PROGRESS` means the operation is reserved and the
/// outcome is not yet conclusive. There is no `FAILED`: a provider timeout
/// is an unknown outcome, not a safe failure.
enum IdempotencyRecordStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_record_status")
}

/// Canonical merchant-processor connection readiness. These are not Stripe
/// account status strings. Semantics:
/// - PENDING: provider account exists; required capabilities are not yet
///   conclusively available and no currently-due/past-due requirements
///   have been observed.
/// - REQUIRES_ACTION: the merchant must complete provider requirements
///   (typically via Stripe-hosted onboarding).
/// - ACTIVE: the capabilities FUP requires for payment operation are
///   currently available (card payments and payouts).
/// - RESTRICTED: previously requested capabilities are blocked without a
///   currently-due onboarding path, or the account cannot operate.
/// - DISCONNECTED: the provider account is closed or otherwise unusable.
///   Application APIs do not set this in the onboarding commit.
enum ProviderAccountConnectionStatus {
  PENDING
  REQUIRES_ACTION
  ACTIVE
  RESTRICTED
  DISCONNECTED

  @@map("provider_account_connection_status")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A tenant of FraterUnion Payments. Organizations are the unit of data
/// ownership referenced by every tenant-scoped model (ADR-003).
///
/// Deletion policy: organizations are never physically deleted through
/// ordinary product flows. Every relation from a dependent model back to
/// Organization uses `onDelete: Restrict`, so the database itself refuses to
/// delete an organization while any membership, API key, or audit log still
/// references it. Deactivation is expressed through `status`, not deletion.
model Organization {
  id   String @id @default(uuid(7)) @db.Uuid
  name String
  /// Globally unique, URL-safe tenant identifier.
  slug String @unique

  type   OrganizationType   @default(BUSINESS)
  status OrganizationStatus @default(ACTIVE)

  /// Uppercase ISO 4217 currency code. Stored as plain text; validated by
  /// application code, not by the database (see README).
  defaultCurrency String @map("default_currency") @db.VarChar(3)
  /// Uppercase ISO 3166-1 alpha-2 country code. Same validation boundary as
  /// `defaultCurrency`.
  countryCode     String @map("country_code") @db.VarChar(2)
  /// IANA timezone identifier (for example, "America/New_York"). Validated
  /// by application code.
  timezone        String @db.VarChar(64)

  /// Free-form organization metadata. Defaults to an empty JSON object so
  /// callers are never required to supply it explicitly.
  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships                OrganizationMembership[]
  apiKeys                    ApiKey[]
  auditLogs                  AuditLog[]
  outboxEvents               OutboxEvent[]
  inboxEvents                InboxEvent[]
  customers                  Customer[]
  customerProviderMappings   CustomerProviderMapping[]
  payments                   Payment[]
  refunds                    Refund[]
  idempotencyRecords         IdempotencyRecord[]
  providerAccountConnections ProviderAccountConnection[]

  @@index([status])
  @@index([type])
  @@map("organizations")
}

/// A person who can authenticate against FraterUnion Payments. Authentication
/// secrets live on `UserCredential`, a separate model, so identity metadata
/// stays independent of auth material (see `UserCredential`).
model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Globally unique identity. Application writes store the canonical form
  /// (trim + lowercase). `@unique` remains so Prisma can `findUnique` /
  /// `upsert` by exact email — the application always looks up the
  /// canonical value. Case-insensitive uniqueness is additionally enforced
  /// by the PostgreSQL functional unique index `users_email_lower_uidx`
  /// (`LOWER(email)`), defined in the `enforce_canonical_email_uniqueness`
  /// migration. Prisma cannot declare expression indexes, so that
  /// invariant is maintained in SQL, not in this schema (see README).
  email       String  @unique @db.VarChar(320)
  displayName String? @map("display_name")

  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential     UserCredential?
  memberships    OrganizationMembership[]
  sessions       Session[]
  apiKeysCreated ApiKey[]                 @relation("ApiKeyCreatedBy")
  auditLogEvents AuditLog[]               @relation("AuditLogActorUser")

  @@index([status])
  @@map("users")
}

/// A user's password authentication material. Deliberately separate from
/// `User` so identity metadata (returned in API responses, joined broadly)
/// never sits in the same table as a secret hash. Exactly one credential per
/// user in this commit: no password history, no reset tokens, no OAuth
/// linkage. Only the Argon2id hash is stored; the plaintext password is
/// never persisted or logged (see docs/architecture/authentication-and-access-control.md).
///
/// Deletion policy: cascades with the user. A credential has no meaning once
/// its user is gone, and unlike `AuditLog` it is not a historical record.
model UserCredential {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// Argon2id hash string (includes algorithm, version, and cost parameters).
  /// Never the plaintext password.
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// The join between a User and an Organization, carrying the user's role
/// within that organization. Unique per (organizationId, userId): a user
/// holds exactly one role per organization in this commit.
///
/// Deletion policy: deleting the organization is blocked (`Restrict`) for
/// the reasons described on `Organization`. Deleting the user cascades to
/// their memberships (`Cascade`), since a membership has no meaning once
/// the user it refers to is gone; this does not affect audit history, which
/// references users independently and nullably (see `AuditLog`).
model OrganizationMembership {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  role MembershipRole

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

/// A tenant-scoped API credential. Only a cryptographic hash of the secret
/// is ever stored; the plaintext key is never recoverable from this record.
/// Key generation and scope semantics are not implemented in this commit.
///
/// `keyPrefix` uniqueness is scoped to `(organizationId, keyPrefix)`, not
/// global: a short prefix used for dashboard/log identification is not
/// guaranteed collision-free across unrelated organizations unless the
/// (future) generation strategy makes it so. `secretHash` is globally
/// unique, since a hash of a properly random, high-entropy secret should
/// never legitimately collide; a collision indicates a generation bug.
///
/// Deletion policy: organizations block deletion (`Restrict`), same as
/// elsewhere. The creating user is optional and nullable (`SetNull` on
/// delete) so a key survives the removal of the user who created it —
/// revoked keys are retained for history via `status`, never deleted.
model ApiKey {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name       String
  /// Short, non-secret identifier shown in dashboards and logs.
  keyPrefix  String @map("key_prefix") @db.VarChar(16)
  /// Cryptographic hash of the API key secret. Never the plaintext key.
  secretHash String @unique @map("secret_hash") @db.VarChar(255)

  status      ApiKeyStatus
  environment ApiEnvironment

  /// Scope vocabulary is not yet defined; stored as free-form strings.
  scopes String[] @default([])

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// Nullable to support controlled bootstrap/service key creation that has
  /// no associated human user.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser  User?        @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  auditLogEvents AuditLog[]   @relation("AuditLogActorApiKey")

  @@unique([organizationId, keyPrefix])
  @@index([organizationId, environment, status])
  @@index([status])
  @@map("api_keys")
}

/// A server-side authentication session for a User, representing one link in
/// a refresh-token rotation chain. Only a hash of the opaque refresh/session
/// token is stored; the plaintext token is never persisted, and access JWTs
/// are never stored at all (they are stateless and short-lived).
///
/// Rotation model: every successful `POST /auth/refresh` revokes the
/// presented session (setting both `rotatedAt` and `revokedAt`) and creates a
/// new session row linked via `createdBySessionId`. `sessionFamilyId` is
/// shared by every row in the chain since the original login, so reuse of an
/// already-rotated token (a token hash found on a row with `rotatedAt` set)
/// can revoke the entire family in one statement — see
/// docs/architecture/authentication-and-access-control.md. `rotatedAt` is
/// distinct from `revokedAt`: `rotatedAt` means "legitimately superseded by
/// rotation"; `revokedAt` means "no longer usable for any reason" and is
/// always set alongside it. The general liveness check is always
/// `revokedAt IS NULL AND expiresAt > now()`.
///
/// Deletion policy: sessions are ephemeral security state, not historical
/// financial or audit records, so they cascade-delete with their user.
model Session {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Hash of the session/refresh token. Unique because a properly random
  /// token's hash should never legitimately collide; this also serves as
  /// the lookup index, so no separate index is added for it.
  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  /// Shared by every session in one rotation chain, assigned at login and
  /// carried forward unchanged by every subsequent rotation.
  sessionFamilyId String @default(uuid(7)) @map("session_family_id") @db.Uuid

  /// The prior session this row's rotation replaced, if any. Null for the
  /// session created at login.
  createdBySessionId String? @unique @map("created_by_session_id") @db.Uuid

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set whenever this session becomes unusable, for any reason (logout,
  /// logout-all, rotation, reuse-detected family revocation).
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Set only when this session was superseded by a legitimate refresh
  /// rotation. Always accompanied by `revokedAt`. A presented token whose
  /// session already has `rotatedAt` set is a reused, already-rotated token.
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz(3)
  /// Best-effort last-successful-use timestamp; updates are not required to
  /// be transactionally strict.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  /// Native PostgreSQL `inet` type, supported cleanly by Prisma.
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Self-relation modeling the rotation chain. `onDelete: SetNull` matters
  /// only for the eventual cleanup of long-expired rows; ordinary rotation
  /// never deletes sessions.
  createdBySession   Session? @relation("SessionRotationChain", fields: [createdBySessionId], references: [id], onDelete: SetNull)
  rotatedIntoSession Session? @relation("SessionRotationChain")

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionFamilyId])
  @@map("sessions")
}

/// Append-only record of privileged and security-relevant actions.
/// Deliberately has no `updatedAt`: committed rows are never edited.
///
/// PostgreSQL enforces immutability (BEFORE UPDATE OR DELETE trigger) and
/// forbids both actor FKs from being set at once. System actors have
/// neither FK. Actor FKs use `Restrict` so physical user/API-key deletion
/// cannot SET NULL an immutable row — deactivate or revoke instead.
///
/// Prisma cannot express the trigger or CHECK constraints; those live in
/// the `enforce_immutable_audit_logs` migration SQL.
///
/// `organizationId` remains required: tenant audit stays tenant-bound.
/// Platform-wide rows are not represented here (failed logins stay
/// unaudited for that reason). See docs/architecture/audit-logging.md.
model AuditLog {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  actorUserId   String? @map("actor_user_id") @db.Uuid
  actorApiKeyId String? @map("actor_api_key_id") @db.Uuid

  /// Extensible action identifier (for example, "auth.registered").
  action       String  @db.VarChar(128)
  /// Extensible resource type identifier (for example, "user").
  resourceType String  @map("resource_type") @db.VarChar(128)
  resourceId   String? @map("resource_id") @db.VarChar(128)

  requestId String? @map("request_id") @db.VarChar(128)
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  /// Structured event detail. Must be a JSON object. Must never contain
  /// secrets, credentials, tokens, or card data (ADR-005).
  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser    User?        @relation("AuditLogActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorApiKey  ApiKey?      @relation("AuditLogActorApiKey", fields: [actorApiKeyId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, resourceType, resourceId, createdAt])
  @@index([organizationId, actorUserId, createdAt])
  @@index([organizationId, actorApiKeyId, createdAt])
  @@index([organizationId, requestId])
  @@map("audit_logs")
}

/// Durable transactional outbox (ADR-007). A business mutation and an
/// outbox insert share one PostgreSQL transaction; workers claim rows only
/// after commit. Delivery is at-least-once. `organizationId` is nullable so
/// genuine platform/system events are not faked onto a tenant. Failed rows
/// are retained as the dead-letter state — they are never deleted here.
///
/// Prisma cannot express the CHECK constraints that keep status and claim
/// fields consistent; those live in the `add_transactional_outbox_and_inbox`
/// migration SQL.
model OutboxEvent {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null only for genuine platform/system events. Tenant-owned events must
  /// set this explicitly (ADR-003).
  organizationId String? @map("organization_id") @db.Uuid

  eventType     String  @map("event_type") @db.VarChar(128)
  aggregateType String? @map("aggregate_type") @db.VarChar(128)
  aggregateId   String? @map("aggregate_id") @db.VarChar(128)

  /// Immutable event data. Must never contain secrets, credentials, or
  /// card data (see docs/architecture/event-delivery.md).
  payload  Json
  metadata Json @default("{}")

  correlationId String? @map("correlation_id") @db.VarChar(128)
  causationId   String? @map("causation_id") @db.VarChar(128)

  status       OutboxEventStatus @default(PENDING)
  attemptCount Int               @default(0) @map("attempt_count")
  availableAt  DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)

  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  claimExpiresAt DateTime? @map("claim_expires_at") @db.Timestamptz(3)
  claimedBy      String?   @map("claimed_by") @db.VarChar(128)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)

  lastErrorCode    String? @map("last_error_code") @db.VarChar(64)
  lastErrorMessage String? @map("last_error_message") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([status, claimExpiresAt])
  @@index([organizationId])
  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
  @@map("outbox_events")
}

/// Durable inbox for at-least-once inbound events (ADR-007). Deduplicates
/// on `(scopeKey, source, externalEventId)`. `scopeKey` is a non-null
/// ownership discriminator: the organization UUID for tenant events, or
/// the literal `platform` for system/global events. A nullable
/// `(organizationId, source, externalEventId)` unique constraint would
/// allow duplicate platform events because SQL `NULL != NULL`.
///
/// The full inbound payload is not stored here — future provider-webhook
/// infrastructure owns raw event storage. This row keeps a SHA-256 payload
/// hash so a repeated identity with a different body is a conflict, not a
/// silent duplicate.
model InboxEvent {
  id String @id @default(uuid(7)) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid
  /// Non-null identity scope. Always `organizationId` when present, else
  /// `platform`. Enforced by a CHECK constraint in migration SQL.
  scopeKey       String  @map("scope_key") @db.VarChar(64)

  source          String @db.VarChar(128)
  externalEventId String @map("external_event_id") @db.VarChar(256)
  eventType       String @map("event_type") @db.VarChar(128)
  /// Verified inbound JSON object. Stripe webhook ingestion stores the
  /// signed event after signature verification. Payloads may contain
  /// provider PII; never persist PAN, CVC, secrets, or onboarding URLs.
  payload         Json   @default("{}")
  payloadHash     String @map("payload_hash") @db.VarChar(64)

  status       InboxEventStatus @default(RECEIVED)
  attemptCount Int              @default(0) @map("attempt_count")

  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  processedAt         DateTime? @map("processed_at") @db.Timestamptz(3)
  lastErrorCode       String?   @map("last_error_code") @db.VarChar(64)
  lastErrorMessage    String?   @map("last_error_message") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, source, externalEventId])
  @@index([organizationId])
  @@index([status])
  @@index([eventType])
  @@index([receivedAt])
  @@index([processedAt])
  @@map("inbox_events")
}

/// Canonical FraterUnion Payments customer. This is not a Stripe (or any
/// other provider) customer. Provider identifiers live on
/// `CustomerProviderMapping`. Email is a contact field, not identity —
/// it is not unique. Organizations never physically delete customers;
/// they archive them (`status` + `archivedAt`). CHECK constraints in
/// `add_customers_and_provider_mappings` keep those two columns aligned
/// and require metadata to be a JSON object.
///
/// `@@unique([id, organizationId])` exists so mappings can take a
/// composite FK and cannot attach to a customer from another tenant.
model Customer {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  type   CustomerType   @default(INDIVIDUAL)
  status CustomerStatus @default(ACTIVE)

  /// Canonical (trim + lowercase) contact email. Not unique. Not auth.
  email             String? @db.VarChar(320)
  name              String? @db.VarChar(200)
  /// E.164 when present (application-validated).
  phone             String? @db.VarChar(16)
  /// Tenant-owned integration key (for example a GymOS member id). Unique
  /// per organization when non-null. Not a provider identifier.
  externalReference String? @map("external_reference") @db.VarChar(128)
  description       String? @db.VarChar(2000)

  metadata Json @default("{}")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  providerMappings CustomerProviderMapping[]
  payments         Payment[]

  @@unique([id, organizationId])
  @@unique([organizationId, externalReference], map: "customers_org_external_ref_uidx")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@map("customers")
}

/// Mapping from a canonical FUP customer to one provider customer resource.
/// Create/read only — identity fields do not update. Provider account
/// uniqueness uses `providerAccountScope`, a non-null key: `default` when
/// no account is specified, `acct:<id>` when one is. That avoids SQL NULL
/// uniqueness holes and cannot collide with a raw account id of "default".
///
/// Composite FK `(customerId, organizationId) → customers(id, organizationId)`
/// plus `organizationId → organizations` keeps mapping and customer tenants
/// identical. CHECK constraints in the migration keep scope/account aligned.
model CustomerProviderMapping {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  /// Validated `PaymentProviderCode` (not a closed enum).
  provider                 String  @db.VarChar(32)
  /// Optional opaque merchant/account identity. Not a FK to
  /// ProviderAccountConnection — historical mappings predate connections,
  /// and future mappings will copy the connection's providerAccountId as
  /// this opaque string without introducing a provider-specific join.
  providerAccountReference String? @map("provider_account_reference") @db.VarChar(255)
  /// Always non-null uniqueness scope. See model comment.
  providerAccountScope     String  @map("provider_account_scope") @db.VarChar(261)
  providerCustomerId       String  @map("provider_customer_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, provider, providerAccountScope, providerCustomerId], map: "customer_provider_mappings_provider_identity_uidx")
  @@unique([customerId, provider, providerAccountScope], map: "customer_provider_mappings_customer_provider_scope_uidx")
  @@index([organizationId, customerId])
  @@index([organizationId, provider, providerAccountScope])
  @@map("customer_provider_mappings")
}

/// Canonical organization-owned merchant processor connection. This is not a
/// Stripe Account row and does not live on `organizations`. Provider is an
/// extensible VARCHAR (`PaymentProviderCode` shape), not a closed Prisma enum.
/// `providerAccountId` is an opaque external identity — never a UUID and never
/// a Stripe-named column. One active connection per `(organizationId, provider)`
/// in V1; the same external account cannot bind two organizations.
///
/// No onboarding URL, KYC, bank, tax, or person columns. Status is FUP
/// canonical readiness, not a copy of provider status strings. Physical
/// delete is not an application API; Organization FK is RESTRICT.
model ProviderAccountConnection {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Validated `PaymentProviderCode` (not a closed enum).
  provider          String @db.VarChar(32)
  providerAccountId String @map("provider_account_id") @db.VarChar(255)

  status          ProviderAccountConnectionStatus
  paymentsEnabled Boolean                         @map("payments_enabled")
  payoutsEnabled  Boolean                         @map("payouts_enabled")
  requirementsDue Boolean                         @map("requirements_due")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, provider])
  @@unique([provider, providerAccountId])
  @@index([organizationId, status])
  @@map("provider_account_connections")
}

/// Canonical FraterUnion Payments payment. This is not a Stripe PaymentIntent
/// or any other provider object. Provider execution and provider payment IDs
/// are intentionally absent — a later mapping/execution model will attach
/// them without assuming one payment equals one provider object forever.
///
/// Monetary columns are PostgreSQL BIGINT (Prisma BigInt), never floats.
/// CHECK constraints in `add_payments` enforce amount inequalities, currency
/// shape, object metadata, failure-field consistency, and SUCCEEDED capture.
///
/// `customerId` is optional (guest/one-off checkout). When present, the
/// composite FK `(customerId, organizationId) → customers(id, organizationId)`
/// makes cross-tenant attach impossible. PostgreSQL MATCH SIMPLE skips the
/// check when `customerId` is NULL.
///
/// Concurrency uses SELECT FOR UPDATE in the application transaction, not
/// an optimistic `version` column — status-based domain transitions already
/// make conflicting updates illegal after the row is locked.
model Payment {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid

  status        PaymentStatus
  captureMethod PaymentCaptureMethod @map("capture_method")

  /// Uppercase ISO 4217. Application uses payment-core validation; DB CHECK
  /// enforces the three-letter shape.
  currency         String @db.VarChar(3)
  requestedAmount  BigInt @map("requested_amount")
  authorizedAmount BigInt @default(0) @map("authorized_amount")
  capturedAmount   BigInt @default(0) @map("captured_amount")
  refundedAmount   BigInt @default(0) @map("refunded_amount")

  failureCategory  PaymentFailureCategory? @map("failure_category")
  failureCode      String?                 @map("failure_code") @db.VarChar(64)
  failureMessage   String?                 @map("failure_message") @db.VarChar(512)
  failureRetryable Boolean?                @map("failure_retryable")

  description String? @db.VarChar(500)
  metadata    Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  refunds      Refund[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, currency, createdAt])
  @@map("payments")
}

/// Durable financial-operation idempotency. Unique per
/// `(organizationId, scope, keyHash)` where `keyHash` is SHA-256 of the
/// `Idempotency-Key` header. The raw key is not stored. `id` is the FUP
/// operation identity used later to derive a provider idempotency key —
/// never the client header.
///
/// `resourceType` / `resourceId` is the durable subject/result identity,
/// not a claim that this record created the row. Create scopes bind the
/// created Payment/Refund. Mutation scopes (authorize, capture, cancel,
/// execute) bind the existing target aggregate. There is no polymorphic
/// FK — the financial mutation and this row share the caller's transaction.
///
/// Atomic creates insert `COMPLETED`. Future provider commands may insert
/// `IN_PROGRESS` first. Records are retained indefinitely until a
/// deliberate retention policy exists. No worker lease lives here.
model IdempotencyRecord {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  /// Registry-validated operation name, for example `payment.create`.
  scope              String                  @db.VarChar(64)
  keyHash            String                  @map("key_hash") @db.Char(64)
  requestFingerprint String                  @map("request_fingerprint") @db.Char(64)
  resourceType       String                  @map("resource_type") @db.VarChar(64)
  resourceId         String                  @map("resource_id") @db.Uuid
  status             IdempotencyRecordStatus @default(COMPLETED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, keyHash], map: "idempotency_records_org_scope_key_uidx")
  @@unique([scope, resourceId], map: "idempotency_records_scope_resource_uidx")
  @@index([organizationId, resourceType, resourceId], map: "idempotency_records_org_resource_idx")
  @@index([organizationId, status, updatedAt], map: "idempotency_records_org_status_updated_idx")
  @@map("idempotency_records")
}

/// Canonical FraterUnion Payments refund. This is not a Stripe Refund or
/// any other provider object. Provider refund IDs are intentionally absent
/// — a later execution/mapping model can attach provider attempts without
/// assuming one refund equals one provider object forever.
///
/// `CREATED` is an internal refund request, not proof that money moved
/// externally. `PROCESSING` / `SUCCEEDED` / `FAILED` are internal
/// lifecycle transitions for future orchestration.
///
/// Capacity reservation: CREATED + PROCESSING + SUCCEEDED consume captured
/// funds. FAILED releases the reservation. `Payment.refundedAmount` is the
/// sum of SUCCEEDED refunds only.
///
/// Composite FK `(paymentId, organizationId) → payments(id, organizationId)`
/// makes cross-tenant attach impossible. Lock order is Payment then Refund.
model Refund {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  paymentId      String @map("payment_id") @db.Uuid

  status RefundStatus

  /// Copied from the parent payment at creation. Must match payment currency.
  currency String @db.VarChar(3)
  amount   BigInt

  reason RefundReason?

  failureCategory  PaymentFailureCategory? @map("failure_category")
  failureCode      String?                 @map("failure_code") @db.VarChar(64)
  failureMessage   String?                 @map("failure_message") @db.VarChar(512)
  failureRetryable Boolean?                @map("failure_retryable")

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, paymentId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("refunds")
}
